{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "node ../scripts/vercel-ignore-build.mjs storefront",
  "rewrites": [
    {
      "source": "/product/:slug",
      "destination": "/product/:slug.html"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "node ../scripts/vercel-ignore-build.mjs control-center",
  "routes": [
    {
      "src": "/api/create-apply",
      "dest": "/api/create-apply-router"
    },
    {
      "handle": "filesystem"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:route",
      "destination": "/api/router?route=:route"
    }
  ]
}
